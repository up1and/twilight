# Twilight Deployment Configuration Sample
# Copy this file to .env and update the values for your node

# --- [CONNECTION SETTINGS] ---
# SERVER_URL: The address where the Flask API is reachable.
# - On Master Node: Keep commented out to use internal 'http://server:5000'
# - On Remote Worker Node: Set to 'http://<MASTER_IP>:5000'
# SERVER_URL=http://localhost:5000

# MINIO_ENDPOINT: The address where the MinIO API is reachable.
# - On Master Node: Keep commented out to use internal 'minio:9000'
# - On Remote Worker Node: Set to '<MASTER_IP>:9000'
# MINIO_ENDPOINT=localhost:9000

# REDIS_URL: The connection string for Redis.
# - Only used by the Server node.
# REDIS_URL=redis://redis:6379/0

# --- [COMMON SHARED SETTINGS] ---
# MinIO Credentials (shared across all components)
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# Max cache size for satellite data processing (in GB)
CACHE_SIZE_LIMIT=200

# Authentication key for worker-to-server API requests
AUTH_KEY=twilight-secret

# --- [SERVER & WORKER SHARED] ---
# Available types: ir_clouds, true_color, ash, airmass,
#                  night_microphysics, day_microphysics, 
#                  fog, convection, water_vapor
# Comma-separated list.
# AVAILABLE_COMPOSITES="ir_clouds,true_color,ash,airmass,night_microphysics,day_microphysics,fog,convection,water_vapor"

# Task expiration in days (0 = no expiration)
# TASK_EXPIRE_DAYS=7

# Sync expiration in days (0 = no expiration)
# SYNC_EXPIRE_DAYS=30

# --- [WORKER SETTINGS] ---
# Task priority filter: "high", "normal", "low". Comma-separated, empty for all.
# PRIORITIES=high,normal
# Composite type filter: "ir_clouds", "true_color", "ash", "night_microphysics". Comma-separated, empty for all.
# COMPOSITES=ir_clouds,true_color,night_microphysics
# Maximum resolution in meters (500, 1000, or 2000). Smaller = higher resolution.
# MAX_RESOLUTION=1000
# Resampler algorithm: "nearest", "bilinear", "native", etc.
# RESAMPLER=nearest
# Estimated RAM consumption per worker in GB (Default: 7.0)
# MEM_PER_WORKER=7.0
# RAM to keep free for OS and other tasks in GB (Default: 4.0)
# SYSTEM_MARGIN=4.0
# Region bounding box: [lon_min, lat_min, lon_max, lat_max]
# BBOX=75,0,160,55
